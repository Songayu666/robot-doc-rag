APP_NAME=Robot Document RAG
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/robot_rag
REDIS_URL=redis://localhost:6379/0
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=20
TASK_STEP_DELAY_SECONDS=1.0
TASK_POLL_INTERVAL_SECONDS=0.1
SSE_HEARTBEAT_SECONDS=15.0

# Copy this file to .env for local development.
# Never commit real API keys or production passwords.
